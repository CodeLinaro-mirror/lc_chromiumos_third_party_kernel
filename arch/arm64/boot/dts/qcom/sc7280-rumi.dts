/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "sc7280.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. SC7280 RUMI platform";
	compatible = "qcom,sc7280-rumi";

	aliases {
		serial0 = &uart5;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&qupv3_id_0 {
	status = "okay";
};

&uart5 {
	status = "okay";
};

/* PINCTRL - additions to nodes defined in sc7280.dtsi */

&qup_uart5_default {
	pinconf-tx {
		pins = "gpio46";
		drive-strength = <2>;
		bias-disable;
	};

	pinconf-rx {
		pins = "gpio47";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&sdhc_1 {
	status = "okay";


	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc1_on>;
	pinctrl-1 = <&sdc1_off>;

	vmmc = <&vreg_l7b_2p9>;
	vqmmc = <&vreg_l19b_1p8>;

	cap-mmc-highspeed;
	max-frequency = <50000000>;

	/delete-property/mmc-ddr-1_8v;
	/delete-property/mmc-hs200-1_8v;
	/delete-property/mmc-hs400-1_8v;
	/delete-property/mmc-hs400-enhanced-strobe;

};

&sdhc_2 {
	status = "okay";


	pinctrl-names = "default","sleep";
	pinctrl-0 = <&sdc2_on>;
	pinctrl-1 = <&sdc2_off>;

	vmmc = <&vreg_l9c_2p9>;
	vqmmc = <&vreg_l6c_2p9>;

	cap-sd-highspeed;
	max-frequency = <50000000>;

	no-1-8-v;

	cd-gpios = <&tlmm 91 GPIO_ACTIVE_LOW>;

};
